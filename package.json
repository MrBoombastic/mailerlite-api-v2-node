{
  "name": "@mrboombastic/mailerlite-api-v2-node",
  "version": "1.3.6",
  "type": "module",
  "description": "[MailerLite API v2](https://developers.mailerlite.com/docs/getting-started-with-mailerlite-api) [Node.js](https://nodejs.org/en/) SDK. It is mostly a thin wrapper on [axios](https://github.com/axios/axios) that provides [authentication](https://developers.mailerlite.com/docs/authentication), response/request camelCase transformations, Typescript type definitions and some handy shorthand methods.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "test": "npx jest --config jest.config.cjs",
    "test:watch": "npx jest --config jest.config.cjs --watch",
    "lint": "npx eslint ./src --ext .ts,.tsx",
    "lint:fix": "npx eslint ./src --fix --ext .ts,.tsx",
    "build": "tsc",
    "prepare": "npm run build"
  },
  "contributors": [
    "zygos",
    "MrBoombastic"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.1",
    "camelcase-keys": "^10.0.2",
    "json-bigint": "^1.0.0",
    "snakecase-keys": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/jest": "^30.0.0",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^24.13.2",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.0.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jest-extended": "^7.0.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrBoombastic/mailerlite-api-v2-node.git"
  },
  "keywords": [
    "mailerlite",
    "node",
    "api"
  ],
  "bugs": {
    "url": "https://github.com/MrBoombastic/mailerlite-api-v2-node/issues"
  },
  "homepage": "https://github.com/MrBoombastic/mailerlite-api-v2-node#readme",
  "files": [
    "dist/**/*"
  ]
}
